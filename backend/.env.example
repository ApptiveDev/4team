SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

POSTGRES_DB=apptive
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/apptive
DB_USERNAME=postgres
DB_PASSWORD=postgres

# 32바이트 이상의 임의 문자열. 실제 값은 커밋하지 않는다.
APP_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_ACCESS_TOKEN_EXPIRATION_DAYS=30

OPENAI_API_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

JPA_SHOW_SQL=false
JPA_DDL_AUTO=update
